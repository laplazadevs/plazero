# --- Discord (required) ---------------------------------------------------
# Bot token used by the bot process and command registration
DISCORD_BOT_TOKEN='your bot token'
# Application (bot) client id — used by register-commands
CLIENT_ID='your bot client id'
# Server (guild) id where slash commands are registered
GUILD_ID='your server id'

# --- Database --------------------------------------------------------------
# Option A (preferred, e.g. production): full connection string.
# DATABASE_URL_UNPOOLED wins over DATABASE_URL when both are set — the bot
# holds a persistent pool, so a direct (non-pgbouncer) connection is best.
# DATABASE_URL_UNPOOLED='postgresql://user:password@host:5432/plazero_bot'
# DATABASE_URL='postgresql://user:password@host:5432/plazero_bot'

# Option B: discrete variables (used when DATABASE_URL is not set)
DB_HOST='localhost'
DB_PORT='5432'
DB_NAME='plazero_bot'
DB_USER='postgres'
DB_PASSWORD='password'

# Legacy aliases still honored (lower precedence than the DB_* variables):
# PGDATABASE, PGUSER, POSTGRES_PASSWORD
