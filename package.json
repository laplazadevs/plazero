{
    "name": "plazero",
    "version": "1.0.0",
    "type": "module",
    "license": "MIT",
    "engines": {
        "node": ">=22"
    },
    "scripts": {
        "prepare": "./scripts/prepare-effect.sh",
        "lint": "biome check .",
        "lint:fix": "biome check --write .",
        "format": "biome format .",
        "format:fix": "biome format --write .",
        "clean": "git clean -xdf --exclude=\".env*\" --exclude=\"backups\" --exclude=\".repos\" --exclude=\".vercel\"",
        "clean:dry": "git clean -xdf --exclude=\".env*\" --exclude=\"backups\" --exclude=\".repos\" --exclude=\".vercel\" --dry-run",
        "build": "tsc --project tsconfig.json && npm run copy-migrations",
        "copy-migrations": "mkdir -p dist/migrations && cp src/migrations/*.sql dist/migrations/",
        "register-commands": "node dist/register-commands.js",
        "start": "npm run build && npm run migrate:up:prod && npm run register-commands && npm run start:bot",
        "start:bot": "node --enable-source-maps dist/main.js",
        "start:production": "npm run start",
        "dev": "npm run migrate:up && tsx src/register-commands.ts && tsx src/main.ts",
        "dev:register": "tsx src/register-commands.ts",
        "migrate": "tsx src/scripts/migrate.ts",
        "migrate:prod": "node dist/scripts/migrate.js",
        "migrate:up": "npm run migrate up",
        "migrate:up:prod": "npm run migrate:prod up",
        "migrate:status": "npm run migrate status",
        "migrate:status:prod": "npm run migrate:prod status",
        "migrate:rollback": "npm run migrate rollback",
        "migrate:rollback:prod": "npm run migrate:prod rollback",
        "migrate:create-db": "npm run migrate create-db",
        "migrate:create-db:prod": "npm run migrate:prod create-db",
        "setup": "npm run migrate:create-db && npm run migrate:up"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.5.5",
        "tsx": "^4.23.1",
        "typescript": "^7.0.2"
    },
    "dependencies": {
        "@discordjs/builders": "^1.14.1",
        "@discordjs/rest": "^2.6.3",
        "@effect/platform-node": "^4.0.0-beta.101",
        "@effect/sql-pg": "^4.0.0-beta.101",
        "dayjs": "^1.11.21",
        "discord-api-types": "^0.38.50",
        "discord.js": "^14.27.0",
        "effect": "^4.0.0-beta.101"
    }
}
